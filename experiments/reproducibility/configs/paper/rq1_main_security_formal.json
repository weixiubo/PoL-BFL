{
  "schema_version": 1,
  "runner": "experiments/scripts/runners/run_rq1_security.py",
  "output_root": "experiments/results/repro_recovery/formal/rq1_main_security",
  "protocol": {
    "pol_remote_mode": "strict_replay",
    "pol_integrity": 1,
    "distance_only_allowed_for_claims": false
  },
  "execution": {
    "rounds": 200,
    "num_clients": 50,
    "clients_per_round": 50,
    "local_epochs": 5,
